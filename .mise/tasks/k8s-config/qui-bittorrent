#!/usr/bin/env bash
#MISE description="Configure Qui with qBittorrent instance"
#USAGE flag "-n --namespace <namespace>" default="downloads" help="Kubernetes namespace"
#USAGE flag "--qui-app <app>" default="qui" help="Qui application name"
#USAGE flag "--name <name>" default="qBittorrent" help="Instance display name"
#USAGE flag "--host <url>" default="http://qbittorrent.downloads.svc.cluster.local:8080" help="qBittorrent WebUI URL"
#USAGE flag "-u --user <user>" default="admin" help="qBittorrent username"
#USAGE flag "-p --password <password>" default="" help="qBittorrent password"
#USAGE flag "--no-restart" help="Do not restart Qui deployment after database update"
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
COMMON_LIB="${ROOT_DIR}/scripts/lib/common.sh"

if [[ -f "${COMMON_LIB}" ]]; then
    # shellcheck source=/dev/null
    source "${COMMON_LIB}"
else
    log() {
        local level="$1"; shift
        printf "[%s] %s\n" "${level^^}" "$*"
    }
    check_cli() {
        for cmd in "$@"; do
            command -v "$cmd" &>/dev/null || { echo "Missing required command: $cmd" >&2; exit 1; }
        done
    }
fi

function usage() {
    cat <<EOF
Usage:
  mise run k8s-config:qui-bittorrent [options]

Configure and register a qBittorrent instance into Qui's internal database.

Options:
  --namespace, -n <ns>       Kubernetes namespace (default: downloads)
  --qui-app <app>            Qui application name (default: qui)
  --name <name>              Instance display name (default: qBittorrent)
  --host <url>               qBittorrent WebUI URL (default: http://qbittorrent.downloads.svc.cluster.local:8080)
  --user, -u <user>          qBittorrent username (default: admin)
  --password, -p <pass>      qBittorrent password (default: empty / subnet whitelist bypass)
  --no-restart               Do not restart Qui deployment after database update
  --help, -h                 Show this help message
EOF
    exit 0
}

# Default values
NAMESPACE="${NAMESPACE:-downloads}"
QUI_APP="${QUI_APP:-qui}"
QBIT_NAME="${QBIT_NAME:-qBittorrent}"
QBIT_HOST="${QBIT_HOST:-http://qbittorrent.downloads.svc.cluster.local:8080}"
QBIT_USER="${QBIT_USER:-admin}"
QBIT_PASS="${QBIT_PASS:-}"
RESTART=true

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --namespace|-n)
            NAMESPACE="$2"
            shift 2
            ;;
        --qui-app)
            QUI_APP="$2"
            shift 2
            ;;
        --name)
            QBIT_NAME="$2"
            shift 2
            ;;
        --host)
            QBIT_HOST="$2"
            shift 2
            ;;
        --user|-u)
            QBIT_USER="$2"
            shift 2
            ;;
        --password|-p)
            QBIT_PASS="$2"
            shift 2
            ;;
        --no-restart)
            RESTART=false
            shift
            ;;
        --help|-h)
            usage
            ;;
        *)
            log error "Unknown argument: $1"
            ;;
    esac
done

check_cli kubectl

# Detect python executable with cryptography or fallback
PYTHON_BIN=""
if /usr/bin/python3 -c "import sqlite3; from cryptography.hazmat.primitives.ciphers.aead import AESGCM" &>/dev/null; then
    PYTHON_BIN="/usr/bin/python3"
elif python3 -c "import sqlite3; from cryptography.hazmat.primitives.ciphers.aead import AESGCM" &>/dev/null; then
    PYTHON_BIN="python3"
elif python3 -c "import sqlite3" &>/dev/null; then
    PYTHON_BIN="python3"
elif /usr/bin/python3 -c "import sqlite3" &>/dev/null; then
    PYTHON_BIN="/usr/bin/python3"
else
    log error "python3 with sqlite3 module is required"
fi

log info "Target configuration" "namespace=${NAMESPACE}" "qui=${QUI_APP}" "instance=${QBIT_NAME}" "host=${QBIT_HOST}" "user=${QBIT_USER}"

# Verify active Qui pod
log info "Finding active Qui pod"
QUI_POD=$(kubectl get pod -n "${NAMESPACE}" -l app.kubernetes.io/name="${QUI_APP}" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
if [[ -z "${QUI_POD}" ]]; then
    log error "No running Qui pod found in namespace ${NAMESPACE} with label app.kubernetes.io/name=${QUI_APP}"
fi
log info "Found Qui pod" "pod=${QUI_POD}"

# Retrieve QUI__SESSION_SECRET
log info "Retrieving session secret"
SESSION_SECRET=$(kubectl get secret -n "${NAMESPACE}" "${QUI_APP}" -o jsonpath='{.data.QUI__SESSION_SECRET}' 2>/dev/null | base64 -d 2>/dev/null || true)

if [[ -z "${SESSION_SECRET}" ]]; then
    log warn "Secret ${QUI_APP} does not contain QUI__SESSION_SECRET, reading config.toml from pod"
    SESSION_SECRET=$(kubectl exec -n "${NAMESPACE}" "${QUI_POD}" -c app -- grep -E '^[[:space:]]*sessionSecret[[:space:]]*=' /config/config.toml 2>/dev/null | awk -F'"' '{print $2}' || true)
fi

if [[ -z "${SESSION_SECRET}" || ${#SESSION_SECRET} -lt 32 ]]; then
    log error "Failed to determine valid sessionSecret (must be at least 32 characters)"
fi

# Function to encrypt password with AES-256-GCM
encrypt_password() {
    local secret="$1"
    local password="$2"

    if "${PYTHON_BIN}" -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM" &>/dev/null; then
        "${PYTHON_BIN}" -c "
import os, sys, base64
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
secret = sys.argv[1]
password = sys.argv[2]
key = secret[:32].encode('utf-8')
aesgcm = AESGCM(key)
nonce = os.urandom(12)
ct = aesgcm.encrypt(nonce, password.encode('utf-8'), None)
sys.stdout.write(base64.b64encode(nonce + ct).decode('utf-8'))
" "${secret}" "${password}"
    elif command -v go &>/dev/null; then
        go run - "${secret}" "${password}" << 'EOF'
package main
import (
    "crypto/aes"
    "crypto/cipher"
    "crypto/rand"
    "encoding/base64"
    "fmt"
    "io"
    "os"
)
func main() {
    secret := os.Args[1]
    key := []byte(secret[:32])
    pwd := ""
    if len(os.Args) > 2 { pwd = os.Args[2] }
    block, err := aes.NewCipher(key)
    if err != nil { os.Exit(1) }
    gcm, err := cipher.NewGCM(block)
    if err != nil { os.Exit(1) }
    nonce := make([]byte, gcm.NonceSize())
    if _, err := io.ReadFull(rand.Reader, nonce); err != nil { os.Exit(1) }
    fmt.Print(base64.StdEncoding.EncodeToString(gcm.Seal(nonce, nonce, []byte(pwd), nil)))
}
EOF
    else
        log error "Neither python3-cryptography nor go compiler is available to encrypt the password"
    fi
}

log info "Encrypting instance credentials"
ENCRYPTED_PASS=$(encrypt_password "${SESSION_SECRET}" "${QBIT_PASS}")
if [[ -z "${ENCRYPTED_PASS}" ]]; then
    log error "Failed to encrypt password"
fi

# Create temporary directory for database manipulation
TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT

log info "Copying qui.db from pod"
kubectl cp "${NAMESPACE}/${QUI_POD}:/config/qui.db" "${TMP_DIR}/qui.db"
kubectl cp "${NAMESPACE}/${QUI_POD}:/config/qui.db-wal" "${TMP_DIR}/qui.db-wal" 2>/dev/null || true

# Register/update instance in sqlite database
log info "Updating database registration"
"${PYTHON_BIN}" -c "
import sqlite3, sys

db_path = sys.argv[1]
inst_name = sys.argv[2]
inst_host = sys.argv[3]
inst_user = sys.argv[4]
enc_pass = sys.argv[5]

conn = sqlite3.connect(db_path)
cur = conn.cursor()

# Checkpoint any WAL frames into main DB
cur.execute('PRAGMA wal_checkpoint(TRUNCATE);')

def intern_string(val):
    cur.execute('INSERT OR IGNORE INTO string_pool (value) VALUES (?)', (val,))
    cur.execute('SELECT id FROM string_pool WHERE value = ?', (val,))
    return cur.fetchone()[0]

name_id = intern_string(inst_name)
host_id = intern_string(inst_host)
user_id = intern_string(inst_user)

cur.execute('SELECT id FROM instances WHERE name_id = ?', (name_id,))
row = cur.fetchone()

if row:
    inst_id = row[0]
    cur.execute('''
        UPDATE instances
        SET host_id = ?, username_id = ?, password_encrypted = ?, is_active = 1
        WHERE id = ?
    ''', (host_id, user_id, enc_pass, inst_id))
    print(f'Updated existing instance record id {inst_id} ({inst_name})')
else:
    cur.execute('SELECT COALESCE(MAX(sort_order), -1) + 1 FROM instances')
    next_sort = cur.fetchone()[0]
    cur.execute('''
        INSERT INTO instances (
            name_id, host_id, username_id, password_encrypted,
            api_key_encrypted, basic_username_id, basic_password_encrypted,
            tls_skip_verify, sort_order, is_active,
            has_local_filesystem_access, use_hardlinks,
            hardlink_base_dir, hardlink_dir_preset,
            use_reflinks, fallback_to_regular_mode
        ) VALUES (
            ?, ?, ?, ?,
            \"\", NULL, NULL,
            0, ?, 1,
            0, 0,
            \"\", \"flat\",
            0, 0
        )
    ''', (name_id, host_id, user_id, enc_pass, next_sort))
    print(f'Created new instance record ({inst_name})')

conn.commit()

# Print current state
for r in cur.execute('SELECT id, name, host, username, is_active FROM instances_view'):
    print(f'Instance: id={r[0]} name={r[1]} host={r[2]} user={r[3]} active={r[4]}')

conn.close()
" "${TMP_DIR}/qui.db" "${QBIT_NAME}" "${QBIT_HOST}" "${QBIT_USER}" "${ENCRYPTED_PASS}"

log info "Copying updated database back to pod"
kubectl cp "${TMP_DIR}/qui.db" "${NAMESPACE}/${QUI_POD}:/config/qui.db"
kubectl exec -n "${NAMESPACE}" "${QUI_POD}" -c app -- rm -f /config/qui.db-wal /config/qui.db-shm 2>/dev/null || true

if [[ "${RESTART}" == "true" ]]; then
    log info "Restarting Qui deployment to reload client pool"
    kubectl rollout restart deploy/"${QUI_APP}" -n "${NAMESPACE}"
    kubectl rollout status deploy/"${QUI_APP}" -n "${NAMESPACE}" --timeout=120s

    NEW_POD=$(kubectl get pod -n "${NAMESPACE}" -l app.kubernetes.io/name="${QUI_APP}" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
    if [[ -n "${NEW_POD}" ]]; then
        # Check logs for decryption error
        if kubectl logs -n "${NAMESPACE}" "${NEW_POD}" -c app 2>/dev/null | grep -i "Failed to decrypt password" &>/dev/null; then
            log error "Qui pod reported decryption failure in logs!"
        fi
    fi
fi

log info "Qui configured successfully with qBittorrent" "host=${QBIT_HOST}"
